tmp-preview/

# Local browser profiles and visual test artifacts are not source assets.
tmp-chrome-profile/
tmp-*.png

# Never commit credentials, runtime payloads, or customer leads.
.env
.env.*
!.env.example
leads/*
!leads/.gitkeep
*workflow-export*.json
execution-*.json
*.sqlite
*.sqlite-*
*.db
*.db-*
*.log

# Owner-only menu data. The central draft is the private editable catalogue and
# the publish state is the local build stamp; both are written by the admin tool
# on this machine and must never be committed (the draft carries internal notes
# and per-side costs). data/business-rules.json, planner-overrides.json and
# sync-manifest.json ARE committed — those are the public sources.
data/menu-central.json
data/menu-publish-state.json
data/*.bak
data/*.tmp
data/owner-costs.json

# Project-owned Node dependencies (package.json/lock are committed, modules are not).
node_modules/

# Phase 1 — local-only image archive (272 unused files, ~271 MB).
# img/ = deploy (90 used files, ~50 MB). img_archive_local/ stays on machine only.
img_archive_local/
# Empty legacy staging dir (all content moved to img/ root or img_archive_local/).
img/picmenu/

# Local-only owner review demos (noindex pages for design approval).
# Kept on this machine for preview; never committed or deployed.
demo/
