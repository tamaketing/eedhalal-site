# Copy to a local .env file or configure these values in the service environment.
# Never commit real values.

# Public LINE gateway
LINE_CHANNEL_SECRET=
N8N_INTERNAL_WEBHOOK_URL=http://127.0.0.1:5678/webhook/line-webhook
EED_WEBHOOK_FORWARD_SECRET=
LINE_GATEWAY_HOST=127.0.0.1
LINE_GATEWAY_PORT=8787

# n8n API publishing and verification
N8N_BASE_URL=https://n8n.example.com
N8N_API_KEY=
N8N_LINE_WORKFLOW_ID=
N8N_PROJECT_ID=
N8N_CLI_PATH=
OPENAI_CREDENTIAL_NAME=
OPENCODE_TEMP=

# Customer-data lifecycle
LEADS_DIR=
LEAD_RETENTION_DAYS=30

# Central database (Phase 3). Never commit real values or passwords.
# memory = ephemeral (tests/CI default) | file = local JSON docs (DB_DIR)
# postgres = production target, needs DATABASE_URL + `npm install pg` on that host only.
DB_ADAPTER=
DB_DIR=
DATABASE_URL=
# PGSSLMODE=require to verify the PostgreSQL server certificate. Never disable verification.
PGSSLMODE=

# Internal business API (Phase 4A, loopback only). Never commit the secret.
EED_INTERNAL_API_SECRET=
INTERNAL_API_HOST=127.0.0.1
INTERNAL_API_PORT=8788

# Production monitoring
SITE_URL=https://eedhalal.com
BOT_HEALTH_URL=https://bot.example.com/healthz
BOT_MONITORING_ENABLED=false
ALERT_WEBHOOK_URL=
LINE_GATEWAY_URL=https://bot.example.com/line-webhook
