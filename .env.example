# Copy to a local .env file or configure these values in the service environment.
# Never commit real values.

# Central database. Never commit real values or passwords.
# memory = ephemeral (tests/CI default) | file = local JSON docs (DB_DIR)
# postgres = production target, needs DATABASE_URL + `npm install pg` on that host only.
DB_ADAPTER=
DB_DIR=
DATABASE_URL=
# PGSSLMODE=require to verify the PostgreSQL server certificate. Never disable verification.
PGSSLMODE=

# Internal business API (loopback only). Never commit the secret.
EED_INTERNAL_API_SECRET=
INTERNAL_API_HOST=127.0.0.1
INTERNAL_API_PORT=8788

# Owner-approved LINE Push sender. Only used when the owner clicks "Send" in the
# Owner Console (server-side). Provision from LINE Developers > Messaging API >
# Channel access token. Never commit a real token and never expose it to
# browsers or logs. Empty = the send endpoint fails closed.
LINE_CHANNEL_ACCESS_TOKEN=

# Production monitoring
SITE_URL=https://eedhalal.com
ALERT_WEBHOOK_URL=